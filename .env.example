# Rekuway IDN — API (Node/Express). Copie para .env e preencha. NUNCA versione o .env.

# Redis (Upstash REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Segredo compartilhado com o dashboard (header x-internal-secret).
# Sem ele, /internal/* recusa todas as requisições. Gere com: openssl rand -hex 32
INTERNAL_SECRET=

# Chave (64 hex = 32 bytes) que criptografa em repouso os tokens que guardam a chave
# privada no Redis. Sem ela, usa-se uma chave derivada de INTERNAL_SECRET.
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Segredo do Vercel Cron para GET /internal/deadman-sweep (opcional).
# Em Railway (processo longo) o monitor interno já roda a cada 5 s.
CRON_SECRET=

# Chave HTTPS da ip-api (pro) para geolocalização/VPN nos eventos. Vazio = sem consulta externa.
IPAPI_PRO_KEY=

# CORS: origens permitidas, separadas por vírgula (ex.: https://app.exemplo.com).
# Vazio = nenhuma origem de navegador é liberada.
ALLOWED_ORIGINS=

# Serviço de IA (opcional). Sem URL e token, o sistema decide só com as regras.
AI_SERVICE_URL=
# Mesmo valor configurado no ai-service. Gere com: openssl rand -hex 32
AI_SERVICE_TOKEN=
# Timeout da chamada de IA em ms (padrão 3000)
AI_SERVICE_TIMEOUT_MS=3000

# Dashboard que recebe eventos (opcional)
DASHBOARD_URL=

PORT=3000
