{
  "enabled": true,
  "modelVersion": "1.0.0-rule-based",
  "description": "AI-assisted risk intelligence with deterministic enforcement",
  "thresholds": {
    "threatScoreHigh": 0.7,
    "threatScoreCritical": 0.9,
    "confidenceMinimum": 0.5
  },
  "weights": {
    "attemptFrequency": 0.25,
    "ipRotation": 0.20,
    "geolocationChange": 0.15,
    "fingerprintInconsistency": 0.15,
    "postRegenerationPattern": 0.15,
    "timeDeviation": 0.10
  },
  "features": {
    "riskScoring": true,
    "threatDetection": true,
    "governance": true,
    "mlEndpoint": null
  },
  "logging": {
    "enabled": true,
    "ttlSeconds": 86400,
    "verboseMode": true
  }
}