{
  "name": "rekuway-idn-mvp",
  "version": "1.0.0",
  "description": "Identity Deadman Network - Self-destructing temporary identities",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "vercel-build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sdk/tsconfig.json",
    "lint": "eslint src/ tests/ sdk/",
    "prepare": "husky || true",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"sdk/**/*.ts\" vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"sdk/**/*.ts\" vitest.config.ts",
    "check": "npm run secrets:scan && npm run format:check && npm run typecheck && npm run lint && npm test",
    "secrets:scan": "node scripts/secret-scan.mjs --all",
    "secrets:scan:history": "node scripts/secret-scan.mjs --history"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "@upstash/redis": "^1.36.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "p-limit": "^7.2.0",
    "typescript": "^5.3.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "axios": "^1.13.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
